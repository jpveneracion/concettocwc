DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# NextAuth Configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl
NEXTAUTH_URL=http://localhost:3000

# OAuth Integration
# Google OAuth - Get credentials from: https://console.cloud.google.com/
# 1. Create project → Enable Google+ API
# 2. Configure OAuth consent screen (External)
# 3. Create OAuth client ID (Web application)
# 4. Add redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Pi Network OAuth - Get credentials from: https://developers.pi.com/
# 1. Create app → Enable Pi Sign-in
# 2. Get OAuth Client ID
# 3. Add redirect URIs: http://localhost:3000/auth/pi/callback
NEXT_PUBLIC_PI_CLIENT_ID=your_pi_client_id_here

# Pi Network Payments (sandbox/test)
# 1. Enable Payments in the Pi Developer Portal
# 2. Get API key from: Developer Portal → Payments → App settings
PI_API_KEY=your_pi_api_key_here
# PHP → USD conversion rate for computing Pi amounts (1 Pi = 1 USD)
PHP_TO_USD_RATE=0.0178571

# Pi Network manual payments (mainnet wallet)
# Your Pi Wallet address and a QR image generated from the Pi Wallet app (Pay -> QR)
PI_WALLET_ADDRESS=your_pi_wallet_address_here
PI_WALLET_QR_URL=your_pi_wallet_qr_url_here
PI_ACCOUNT_NAME=Concetto Inc.

# Pinata IPFS Configuration
PINATA_API_KEY=your_api_key_here
PINATA_SECRET_API_KEY=your_secret_key_here
PINATA_JWT_KEY=your_jwt_token_here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Pinata Region Configuration (optional)
PINATA_REGION_FRA=FRA1
PINATA_REGION_NYC=NYC1
PINATA_REPLICATION_COUNT=1

# Cookie Domain Configuration
# For development: leave empty for localhost (default behavior)
# For production: set to your domain with leading dot for subdomain support
# Examples: .example.com or .concetto.com
COOKIE_DOMAIN=
