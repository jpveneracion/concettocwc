-- migrations/016_enable_rls_products.sql
-- Row-Level Security Policies for Products Table
--
-- This migration enables comprehensive RLS on the products table to enforce
-- tenant isolation at the database level for sensitive business data.
--
-- Security Model:
-- - Tenant Isolation: Users can only access products from their company
-- - Admin Access: Company admins can access all products in their company
-- - Superadmin Access: Superadmins can access products across all companies
-- - Write Protection: Prevent cross-company data modifications
-- - Business Data Protection: Combine RLS with existing data validation

-- ============================================================================
-- ENABLE RLS ON PRODUCTS TABLE
-- ============================================================================

-- Enable Row-Level Security on the products table
ALTER TABLE products ENABLE ROW LEVEL SECURITY;

-- ============================================================================
-- BASE TENANT ISOLATION POLICY
-- ============================================================================

/**
 * Primary tenant isolation policy for products table
 *
 * This policy enforces that users can only access products belonging to their company,
 * with exceptions for superadmins who can access all companies' data.
 *
 * USING clause: Controls SELECT, UPDATE, DELETE operations
 * WITH CHECK clause: Controls INSERT and UPDATE operations
 *
 * Security Philosophy: Fail secure - deny access if context not properly set
 */
CREATE POLICY products_tenant_isolation ON products
  FOR ALL
  USING (
    -- Require tenant context to be set (fail secure if NULL)
    company_id = get_current_company_id()
    OR is_current_user_superadmin()
  )
  WITH CHECK (
    -- For inserts and updates, ensure the company_id matches current context
    -- unless user is superadmin
    company_id = get_current_company_id()
    OR is_current_user_superadmin()
  );

-- ============================================================================
-- ADMIN ACCESS POLICY WITHIN COMPANY
-- ============================================================================

/**
 * Admin access policy for products within the same company
 *
 * This policy allows company admins to perform all operations on products
 * within their company, but prevents cross-company access.
 *
 * This is redundant with the base isolation policy but provides explicit
 * policy documentation for admin capabilities.
 */
CREATE POLICY products_admin_access ON products
  FOR ALL
  USING (
    is_current_user_admin()
    AND company_id = get_current_company_id()
  )
  WITH CHECK (
    is_current_user_admin()
    AND company_id = get_current_company_id()
  );

-- ============================================================================
-- READ-ONLY ACCESS POLICY FOR RESTRICTED USERS
-- ============================================================================

/**
 * Read-only access policy for users with limited permissions
 *
 * This policy allows regular users to read products from their company
 * but prevents modifications unless they have admin privileges.
 *
 * Note: In this system, product modifications are also controlled by subscription
 * status at the application layer, but this provides database-level defense.
 */
CREATE POLICY products_read_only_access ON products
  FOR SELECT
  USING (
    company_id = get_current_company_id()
    OR is_current_user_superadmin()
  );

-- ============================================================================
-- WRITE PROTECTION POLICY
-- ============================================================================

/**
 * Write protection policy to prevent cross-company data modifications
 *
 * This is a critical security policy that prevents users from modifying
 * products belonging to other companies, even if they somehow bypass application
 * layer controls.
 *
 * This policy applies to INSERT, UPDATE, and DELETE operations.
 */
CREATE POLICY products_write_protection ON products
  FOR INSERT
  WITH CHECK (
    -- Ensure inserted products belong to current user's company
    company_id = get_current_company_id()
    OR is_current_user_superadmin()
  );

CREATE POLICY products_update_protection ON products
  FOR UPDATE
  USING (
    -- Can only update products in own company
    company_id = get_current_company_id()
    OR is_current_user_superadmin()
  )
  WITH CHECK (
    -- Prevent changing company_id on update (critical security control)
    company_id = (SELECT company_id FROM products WHERE id = products.id)
    OR is_current_user_superadmin()
  );

CREATE POLICY products_delete_protection ON products
  FOR DELETE
  USING (
    -- Can only delete products in own company
    company_id = get_current_company_id()
    OR is_current_user_superadmin()
  );

-- ============================================================================
-- SUPERADMIN CROSS-COMPANY ACCESS
-- ============================================================================

/**
 * Superadmin policy for cross-company product access
 *
 * This policy explicitly allows superadmins to access, modify, and delete
 * products from any company. This is necessary for support and auditing purposes.
 *
 * WARNING: This policy should only be granted to trusted superadmin users.
 */
CREATE POLICY products_superadmin_full_access ON products
  FOR ALL
  USING (
    is_current_user_superadmin()
  )
  WITH CHECK (
    is_current_user_superadmin()
  );

-- ============================================================================
-- COMPANY_ID IMMUTABILITY POLICY
-- ============================================================================

/**
 * Critical security policy to prevent company_id changes
 *
 * This policy prevents users from changing the company_id of existing products,
 * which would be a security vulnerability allowing data transfer between companies.
 *
 * This is a defense-in-depth control to prevent potential bypass of other policies.
 */
CREATE POLICY products_company_id_immutable ON products
  FOR UPDATE
  WITH CHECK (
    -- Prevent company_id from being changed (old value must equal new value)
    company_id = (SELECT company_id FROM products WHERE id = products.id)
    OR is_current_user_superadmin()
  );

-- ============================================================================
-- RLS POLICY DOCUMENTATION AND COMMENTS
-- ============================================================================

COMMENT ON POLICY products_tenant_isolation ON products IS 'Primary tenant isolation policy. Users can only access products from their company, except superadmins who can access all companies.';

COMMENT ON POLICY products_admin_access ON products IS 'Admin access policy within company. Allows company admins full access to products in their company.';

COMMENT ON POLICY products_read_only_access ON products IS 'Read-only access policy for regular users. Allows reading products from own company.';

COMMENT ON POLICY products_write_protection ON products IS 'Insert protection policy. Ensures new products are assigned to current user company only.';

COMMENT ON POLICY products_update_protection ON products IS 'Update protection policy. Prevents cross-company product modifications and company_id changes.';

COMMENT ON POLICY products_delete_protection ON products IS 'Delete protection policy. Prevents cross-company product deletions.';

COMMENT ON POLICY products_superadmin_full_access ON products IS 'Superadmin full access policy. Allows superadmins to access all products across all companies.';

COMMENT ON POLICY products_company_id_immutable ON products IS 'Critical security policy. Prevents company_id changes on existing products to prevent data transfer between companies.';

-- ============================================================================
-- INDEX OPTIMIZATION FOR RLS PERFORMANCE
-- ============================================================================

-- Ensure company_id index exists for RLS policy performance
-- This index should already exist from the base schema, but we verify it here
CREATE INDEX IF NOT EXISTS idx_products_company_id ON products(company_id);

-- Create composite index for common RLS queries (company_id + created_at)
-- This optimizes queries that filter by company and sort by creation date
CREATE INDEX IF NOT EXISTS idx_products_company_created ON products(company_id, created_at DESC);

-- Create index for product name lookups within company context
CREATE INDEX IF NOT EXISTS idx_products_company_name ON products(company_id, name);

-- Create index for product sku lookups within company context
CREATE INDEX IF NOT EXISTS idx_products_company_sku ON products(company_id, sku);

-- ============================================================================
-- POLICY TESTING AND VALIDATION FUNCTIONS
-- ============================================================================

/**
 * Test function to validate products RLS policies
 *
 * This function creates test scenarios to validate that RLS policies are
 * working correctly. It tests tenant isolation, admin access, and superadmin access.
 *
 * @returns Test results showing policy effectiveness
 */
CREATE OR REPLACE FUNCTION test_products_rls()
RETURNS TABLE(
  test_name TEXT,
  success BOOLEAN,
  message TEXT,
  details TEXT
)
SET search_path = public
LANGUAGE plpgsql
AS $$
DECLARE
  test_company_1_id UUID;
  test_company_2_id UUID;
  test_user_company_1_id UUID;
  test_admin_company_1_id UUID;
  test_superadmin_id UUID;
  test_product_1_id UUID;
  test_product_2_id UUID;
  access_count INTEGER;
  expected_count INTEGER;
BEGIN
  -- Generate test company IDs
  test_company_1_id := gen_random_uuid();
  test_company_2_id := gen_random_uuid();

  -- Test 1: Verify RLS is enabled
  BEGIN
    IF EXISTS (
      SELECT 1 FROM pg_tables
      WHERE tablename = 'products'
      AND rowsecurity = true
    ) THEN
      RETURN QUERY SELECT 'RLS Enabled'::TEXT, true::BOOLEAN,
        'RLS is enabled on products table'::TEXT, ''::TEXT;
    ELSE
      RETURN QUERY SELECT 'RLS Enabled'::TEXT, false::BOOLEAN,
        'RLS is NOT enabled on products table'::TEXT, ''::TEXT;
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'RLS Enabled'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
  END;

  -- Test 2: Verify tenant context requirement
  BEGIN
    -- Reset context first
    PERFORM reset_tenant_context();

    -- Try to query without context (should fail or return empty)
    SELECT COUNT(*) INTO access_count FROM products;

    -- With no context, should return 0 due to fail-secure policy
    RETURN QUERY SELECT 'Context Requirement'::TEXT, (access_count = 0)::BOOLEAN,
      'Query without context returned ' || access_count || ' rows'::TEXT,
      'Expected 0 rows when context not set'::TEXT;

    PERFORM reset_tenant_context();
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'Context Requirement'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
    PERFORM reset_tenant_context();
  END;

  -- Test 3: Verify tenant isolation
  BEGIN
    -- Set context for company 1
    PERFORM set_tenant_context(test_company_1_id, 'user');

    -- In a real test with actual data, this would only return company 1 products
    -- For this validation, we just verify the context is set correctly
    IF get_current_company_id() = test_company_1_id THEN
      RETURN QUERY SELECT 'Tenant Isolation'::TEXT, true::BOOLEAN,
        'Tenant context correctly set to company_id'::TEXT, test_company_1_id::TEXT;
    ELSE
      RETURN QUERY SELECT 'Tenant Isolation'::TEXT, false::BOOLEAN,
        'Tenant context not correctly set'::TEXT, ''::TEXT;
    END IF;

    PERFORM reset_tenant_context();
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'Tenant Isolation'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
    PERFORM reset_tenant_context();
  END;

  -- Test 4: Verify admin function works
  BEGIN
    -- Test admin check with admin role
    PERFORM set_tenant_context(test_company_1_id, 'admin');

    IF is_current_user_admin() THEN
      RETURN QUERY SELECT 'Admin Check'::TEXT, true::BOOLEAN,
        'Admin role correctly identified'::TEXT, ''::TEXT;
    ELSE
      RETURN QUERY SELECT 'Admin Check'::TEXT, false::BOOLEAN,
        'Admin role not correctly identified'::TEXT, ''::TEXT;
    END IF;

    PERFORM reset_tenant_context();
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'Admin Check'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
    PERFORM reset_tenant_context();
  END;

  -- Test 5: Verify superadmin function works
  BEGIN
    -- Test superadmin check
    PERFORM set_tenant_context(test_company_1_id, 'superadmin');

    IF is_current_user_superadmin() THEN
      RETURN QUERY SELECT 'Superadmin Check'::TEXT, true::BOOLEAN,
        'Superadmin role correctly identified'::TEXT, ''::TEXT;
    ELSE
      RETURN QUERY SELECT 'Superadmin Check'::TEXT, false::BOOLEAN,
        'Superadmin role not correctly identified'::TEXT, ''::TEXT;
    END IF;

    PERFORM reset_tenant_context();
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'Superadmin Check'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
    PERFORM reset_tenant_context();
  END;

  -- Test 6: Verify policies exist
  BEGIN
    -- Check if our key policies exist
    IF EXISTS (
      SELECT 1 FROM pg_policies
      WHERE tablename = 'products'
      AND policyname = 'products_tenant_isolation'
    ) AND EXISTS (
      SELECT 1 FROM pg_policies
      WHERE tablename = 'products'
      AND policyname = 'products_company_id_immutable'
    ) THEN
      RETURN QUERY SELECT 'Policy Existence'::TEXT, true::BOOLEAN,
        'All required RLS policies exist'::TEXT, ''::TEXT;
    ELSE
      RETURN QUERY SELECT 'Policy Existence'::TEXT, false::BOOLEAN,
        'Some required RLS policies are missing'::TEXT, ''::TEXT;
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'Policy Existence'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
  END;

  -- Test 7: Verify company_id immutability
  BEGIN
    -- Test that company_id immutability policy exists
    IF EXISTS (
      SELECT 1 FROM pg_policies
      WHERE tablename = 'products'
      AND policyname = 'products_company_id_immutable'
    ) THEN
      RETURN QUERY SELECT 'Company ID Immutability'::TEXT, true::BOOLEAN,
        'Company ID immutability policy exists'::TEXT, ''::TEXT;
    ELSE
      RETURN QUERY SELECT 'Company ID Immutability'::TEXT, false::BOOLEAN,
        'Company ID immutability policy is missing'::TEXT, ''::TEXT;
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'Company ID Immutability'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
  END;

  -- Test 8: Verify write protection policies
  BEGIN
    -- Check if write protection policies exist
    IF EXISTS (
      SELECT 1 FROM pg_policies
      WHERE tablename = 'products'
      AND policyname = 'products_write_protection'
    ) AND EXISTS (
      SELECT 1 FROM pg_policies
      WHERE tablename = 'products'
      AND policyname = 'products_delete_protection'
    ) THEN
      RETURN QUERY SELECT 'Write Protection'::TEXT, true::BOOLEAN,
        'Write protection policies exist'::TEXT, ''::TEXT;
    ELSE
      RETURN QUERY SELECT 'Write Protection'::TEXT, false::BOOLEAN,
        'Some write protection policies are missing'::TEXT, ''::TEXT;
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RETURN QUERY SELECT 'Write Protection'::TEXT, false::BOOLEAN,
      SQLERRM::TEXT, ''::TEXT;
  END;

  RETURN;
END;
$$;

COMMENT ON FUNCTION test_products_rls() IS 'Test function to validate products RLS policy implementation. Returns test results for policy verification.';

-- ============================================================================
-- SECURITY AUDIT FUNCTIONS
-- ============================================================================

/**
 * Audit function to check for potential RLS policy bypass attempts
 *
 * This function can be used to monitor for suspicious activity that might
 * indicate attempts to bypass RLS policies.
 *
 * @returns Audit information about product access patterns
 */
CREATE OR REPLACE FUNCTION audit_products_rls_access()
RETURNS TABLE(
  event_type TEXT,
  description TEXT,
  severity TEXT
)
SET search_path = public
LANGUAGE plpgsql
AS $$
BEGIN
  -- Check for queries without proper context setup
  -- This would be implemented with additional monitoring infrastructure

  RETURN QUERY SELECT
    'RLS Context Monitoring'::TEXT,
    'Audit function for monitoring products RLS access patterns'::TEXT,
    'INFO'::TEXT;
END;
$$;

COMMENT ON FUNCTION audit_products_rls_access() IS 'Audit function to monitor products RLS access patterns for security purposes.';

-- ============================================================================
-- GRANTS AND PERMISSIONS
-- ============================================================================

-- Ensure application has proper permissions to use RLS functions
-- These permissions should already be granted from the foundation migration

-- ============================================================================
-- ROLLBACK PROCEDURES
-- ============================================================================

/*
 * ROLLBACK INSTRUCTIONS:
 *
 * To rollback this migration and disable RLS on products table:
 *
 * 1. Disable RLS (not recommended in production):
 *    ALTER TABLE products DISABLE ROW LEVEL SECURITY;
 *
 * 2. Drop all policies:
 *    DROP POLICY IF EXISTS products_tenant_isolation ON products;
 *    DROP POLICY IF EXISTS products_admin_access ON products;
 *    DROP POLICY IF EXISTS products_read_only_access ON products;
 *    DROP POLICY IF EXISTS products_write_protection ON products;
 *    DROP POLICY IF EXISTS products_update_protection ON products;
 *    DROP POLICY IF EXISTS products_delete_protection ON products;
 *    DROP POLICY IF EXISTS products_superadmin_full_access ON products;
 *    DROP POLICY IF EXISTS products_company_id_immutable ON products;
 *
 * 3. Drop test functions:
 *    DROP FUNCTION IF EXISTS test_products_rls();
 *    DROP FUNCTION IF EXISTS audit_products_rls_access();
 *
 * 4. Drop indexes (optional):
 *    DROP INDEX IF EXISTS idx_products_company_id;
 *    DROP INDEX IF EXISTS idx_products_company_created;
 *    DROP INDEX IF EXISTS idx_products_company_name;
 *    DROP INDEX IF EXISTS idx_products_company_sku;
 *
 * WARNING: Rolling back RLS policies will remove database-level security
 * and make the application dependent on application-layer security only.
 */

-- ============================================================================
-- IMPLEMENTATION NOTES
-- ============================================================================

/*
 * IMPLEMENTATION NOTES:
 *
 * 1. Policy Order Matters: PostgreSQL evaluates policies in order. The most
 *    restrictive policies should come first, with more permissive policies later.
 *
 * 2. USING vs WITH CHECK:
 *    - USING controls SELECT, UPDATE, DELETE
 *    - WITH CHECK controls INSERT, UPDATE
 *    - Both are needed for comprehensive security
 *
 * 3. Fail-Secure Philosophy: All policies deny access by default if context
 *    is not properly set, preventing accidental data exposure.
 *
 * 4. Performance: Indexes on company_id are critical for RLS performance.
 *    All policies that filter by company_id should use indexed columns.
 *
 * 5. Business Data Protection: These RLS policies work in conjunction with
 *    existing data validation. RLS provides tenant isolation, while application
 *    layer provides business logic validation.
 *
 * 6. Superadmin Access: Superadmin policies should be carefully monitored
 *    and audited, as they provide cross-company data access.
 *
 * 7. Application Layer: Application must call set_tenant_context() at the
 *    start of each request for these policies to work correctly.
 *
 * 8. Testing: The test_products_rls() function provides basic validation.
 *    Additional application-level testing is recommended.
 *
 * 9. Product-Specific Considerations:
 *    - Products table contains business-critical inventory data
 *    - Price and cost information require tenant isolation
 *    - Product catalog changes should be audited
 *    - SKU uniqueness should be enforced within company context
 *
 * 10. Index Strategy:
 *     - idx_products_company_id: Basic tenant filtering
 *     - idx_products_company_created: Time-ordered tenant queries
 *     - idx_products_company_name: Product search within company
 *     - idx_products_company_sku: SKU lookups within company
 *
 * 11. Integration with Existing Features:
 *     - Product creation modal should respect RLS policies
 *     - Admin product management should use admin policies
 *     - Product search should automatically filter by company
 */