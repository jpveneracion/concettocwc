-- Migration: Security Fix - Add Role Context Validation to Authentication Functions
-- Purpose: Add missing authorization controls to remaining authentication functions
-- Issue: Migration 047 authentication functions lack role context validation
-- Pattern: Following secure SECURITY DEFINER approach from Migrations 045/046

-- ============================================================================
-- DROP VULNERABLE AUTHENTICATION FUNCTIONS FOR RECREATION WITH SECURITY
-- ============================================================================

DROP FUNCTION IF EXISTS check_company_exists CASCADE;
DROP FUNCTION IF EXISTS check_user_exists_by_email_hash CASCADE;
DROP FUNCTION IF EXISTS update_user_email_hash CASCADE;
DROP FUNCTION IF EXISTS update_user_password CASCADE;
DROP FUNCTION IF EXISTS get_user_admin_status CASCADE;
DROP FUNCTION IF EXISTS create_company CASCADE;
DROP FUNCTION IF EXISTS create_user CASCADE;

-- ============================================================================
-- FIX 1: SECURE check_company_exists() - Add Role Context Validation
-- ============================================================================

CREATE OR REPLACE FUNCTION check_company_exists(p_code text)
RETURNS boolean
LANGUAGE plpgsql  -- Changed from sql to enable security validation
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  -- Security: Validate role context before company existence check
  IF current_setting('app.role', true) IS NULL THEN
    RAISE EXCEPTION 'Security: No role context set for company lookup';
  END IF;

  -- Return company existence status
  RETURN EXISTS(SELECT 1 FROM companies WHERE UPPER(code) = UPPER(p_code));
END;
$$;

COMMENT ON FUNCTION check_company_exists IS 'SECURITY DEFINER function to check company existence. Role context validation added. Used for signup validation and company lookup.';

GRANT EXECUTE ON FUNCTION check_company_exists(text) TO PUBLIC;

-- ============================================================================
-- FIX 2: SECURE check_user_exists_by_email_hash() - Add Role Context Validation
-- ============================================================================

CREATE OR REPLACE FUNCTION check_user_exists_by_email_hash(p_email_hash text)
RETURNS boolean
LANGUAGE plpgsql  -- Changed from sql to enable security validation
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  -- Security: Validate role context before user existence check
  IF current_setting('app.role', true) IS NULL THEN
    RAISE EXCEPTION 'Security: No role context set for user lookup';
  END IF;

  -- Return user existence status
  RETURN EXISTS(SELECT 1 FROM users WHERE email_hash = p_email_hash);
END;
$$;

COMMENT ON FUNCTION check_user_exists_by_email_hash IS 'SECURITY DEFINER function to check user existence. Role context validation added. Used for duplicate user prevention.';

GRANT EXECUTE ON FUNCTION check_user_exists_by_email_hash(text) TO PUBLIC;

-- ============================================================================
-- FIX 3: SECURE update_user_email_hash() - Add Role Context Validation
-- ============================================================================

CREATE OR REPLACE FUNCTION update_user_email_hash(p_user_id uuid, p_email_hash text)
RETURNS void
LANGUAGE plpgsql  -- Changed from sql to enable security validation
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  -- Security: Validate role context before user email update
  IF current_setting('app.role', true) IS NULL THEN
    RAISE EXCEPTION 'Security: No role context set for user update';
  END IF;

  -- Update user email hash
  UPDATE users SET email_hash = p_email_hash WHERE id = p_user_id;
END;
$$;

COMMENT ON FUNCTION update_user_email_hash IS 'SECURITY DEFINER function to update user email hash. Role context validation added. Used for email change operations.';

GRANT EXECUTE ON FUNCTION update_user_email_hash(uuid, text) TO PUBLIC;

-- ============================================================================
-- FIX 4: SECURE update_user_password() - Add Role Context Validation
-- ============================================================================

CREATE OR REPLACE FUNCTION update_user_password(p_user_id uuid, p_password_hash text)
RETURNS void
LANGUAGE plpgsql  -- Changed from sql to enable security validation
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  -- Security: Validate role context before password update
  IF current_setting('app.role', true) IS NULL THEN
    RAISE EXCEPTION 'Security: No role context set for password update';
  END IF;

  -- Update user password
  UPDATE users SET password_hash = p_password_hash WHERE id = p_user_id;
END;
$$;

COMMENT ON FUNCTION update_user_password IS 'SECURITY DEFINER function to update user password. Role context validation added. CRITICAL: Handles password reset operations.';

GRANT EXECUTE ON FUNCTION update_user_password(uuid, text) TO PUBLIC;

-- ============================================================================
-- FIX 5: SECURE get_user_admin_status() - Add Role Context Validation
-- ============================================================================

CREATE OR REPLACE FUNCTION get_user_admin_status(p_user_id uuid)
RETURNS json
LANGUAGE plpgsql  -- Changed from sql to enable security validation
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  result json;
BEGIN
  -- Security: Validate role context before admin status check
  IF current_setting('app.role', true) IS NULL THEN
    RAISE EXCEPTION 'Security: No role context set for admin status check';
  END IF;

  -- Return user admin status
  SELECT row_to_json(t)::json INTO result
  FROM (
    SELECT
      role,
      (role = 'admin' OR role = 'superadmin' OR is_admin = true) as is_admin
    FROM users
    WHERE id = p_user_id
  ) t;

  RETURN result;
END;
$$;

COMMENT ON FUNCTION get_user_admin_status IS 'SECURITY DEFINER function to check user admin status. Role context validation added. Used for authorization checks.';

GRANT EXECUTE ON FUNCTION get_user_admin_status(uuid) TO PUBLIC;

-- ============================================================================
-- FIX 6: SECURE create_company() - Add Role Context Validation
-- ============================================================================

CREATE OR REPLACE FUNCTION create_company(
  p_code text,
  p_name text,
  p_address text,
  p_mobile text,
  p_email text,
  p_prepared_by text,
  p_minimum_area_sqft numeric
)
RETURNS json
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_company RECORD;
BEGIN
  -- Security: Validate role context before company creation
  IF current_setting('app.role', true) IS NULL THEN
    RAISE EXCEPTION 'Security: No role context set for company creation';
  END IF;

  -- Create company with RLS bypass
  INSERT INTO companies (code, name, address, mobile, email, prepared_by, minimum_area_sqft)
  VALUES (p_code, p_name, p_address, p_mobile, p_email, p_prepared_by, p_minimum_area_sqft)
  RETURNING id, code, name
  INTO v_company;

  RETURN row_to_json(v_company)::json;
END;
$$;

COMMENT ON FUNCTION create_company IS 'SECURITY DEFINER function for company creation. Role context validation added. Used during signup and company provisioning.';

GRANT EXECUTE ON FUNCTION create_company(text, text, text, text, text, text, numeric) TO PUBLIC;

-- ============================================================================
-- FIX 7: SECURE create_user() - Add Role Context Validation
-- ============================================================================

CREATE OR REPLACE FUNCTION create_user(
  p_email text,
  p_password_hash text,
  p_email_hash text,
  p_company_id uuid,
  p_role text
)
RETURNS json
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_user RECORD;
BEGIN
  -- Security: Validate role context before user creation
  IF current_setting('app.role', true) IS NULL THEN
    RAISE EXCEPTION 'Security: No role context set for user creation';
  END IF;

  -- Create user with RLS bypass
  INSERT INTO users (email, password_hash, email_hash, company_id, role)
  VALUES (p_email, p_password_hash, p_email_hash, p_company_id, p_role)
  RETURNING id, email, company_id, role, created_at
  INTO v_user;

  RETURN row_to_json(v_user)::json;
END;
$$;

COMMENT ON FUNCTION create_user IS 'SECURITY DEFINER function for user creation. Role context validation added. Used during signup and user provisioning.';

GRANT EXECUTE ON FUNCTION create_user(text, text, text, uuid, text) TO PUBLIC;

